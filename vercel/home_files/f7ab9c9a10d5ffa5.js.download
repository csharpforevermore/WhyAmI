pport:"}),(0,r.jsxs)("ul",{className:"text-red-700 dark:text-red-300 space-y-1",children:[(0,r.jsxs)("li",{children:["• ",(0,r.jsxs)("a",{href:"https://www.samaritans.org/",target:"_blank",rel:"noopener noreferrer",className:"underline hover:text-red-600",children:[(0,r.jsx)("strong",{children:"116 123"})," - Samaritans"]})]}),(0,r.jsxs)("li",{children:["• ",(0,r.jsxs)("a",{href:"https://www.shout85258.org.uk/",target:"_blank",rel:"noopener noreferrer",className:"underline hover:text-red-600",children:[(0,r.jsx)("strong",{children:"SHOUT"})," - Text 85258"]})]}),(0,r.jsxs)("li",{children:["• ",(0,r.jsxs)("a",{href:"https://www.crisis.org.uk/",target:"_blank",rel:"noopener noreferrer",className:"underline hover:text-red-600",children:[(0,r.jsx)("strong",{children:"Crisis"})," - Mental health support"]})]})]})]})]})]})}),(0,r.jsxs)("div",{className:"mb-6",children:[(0,r.jsxs)("h4",{className:"text-lg font-medium text-gray-900 dark:text-white mb-3",children:["Understanding ",L.title]}),(0,r.jsxs)("div",{className:"prose prose-sm text-gray-700 dark:text-gray-300 mb-4",children:["adhd"===t&&(0,r.jsx)("p",{children:"ADHD (Attention Deficit Hyperactivity Disorder) is a neurodevelopmental condition that affects focus, organisation, and impulse control. It's not about being lazy or unmotivated - it's a real condition that affects how your brain works. Many adults with ADHD are highly creative and energetic, but struggle with daily tasks and time management."}),"anxiety"===t&&(0,r.jsx)("p",{children:"Anxiety is your body's natural response to stress and danger. While some anxiety is normal, excessive worry that interferes with daily life may indicate an anxiety disorder. This can manifest as constant worry, physical symptoms like rapid heartbeat, or avoidance of certain situations. The good news is that anxiety is highly treatable with the right support."}),"depression"===t&&(0,r.jsx)("p",{children:"Depression is more than just feeling sad - it's a serious mental health condition that affects how you think, feel, and behave. It can cause persistent low mood, loss of interest in activities, changes in sleep and appetite, and difficulty concentrating. Depression is treatable, and many people recover fully with appropriate support and treatment."}),"ptsd"===t&&(0,r.jsx)("p",{children:"PTSD (Post-Traumatic Stress Disorder) can develop after experiencing or witnessing a traumatic event. Symptoms may include flashbacks, nightmares, hypervigilance, and avoiding reminders of the trauma. PTSD is a normal response to abnormal events, and with proper treatment, most people can recover and regain control of their lives."}),"autism"===t&&(0,r.jsx)("p",{children:"Autism is a spectrum condition that affects how people communicate, interact, and process information. Autistic people may have different ways of thinking, learning, and experiencing the world. While autism is lifelong, understanding your traits can help you access appropriate support and accommodations to thrive in work, education, and relationships."}),"aces"===t&&(0,r.jsx)("p",{children:"Adverse Childhood Experiences (ACEs) are potentially traumatic events that occur during childhood. These experiences can include abuse, neglect, household dysfunction, and other stressful events. Research shows that ACEs can have lasting effects on mental and physical health, but understanding these connections is the first step toward healing and building resilience."}),"psychosis"===t&&(0,r.jsx)("p",{children:"Psychosis involves experiences where you may lose touch with reality, such as hearing voices, having unusual beliefs, or experiencing changes in thinking patterns. These symptoms can be distressing but are treatable. Early intervention often leads to better outcomes, and many people with psychosis recover fully with appropriate support and treatment."}),"bpd"===t&&(0,r.jsx)("p",{children:"Borderline Personality Disorder (BPD) is characterized by intense emotional experiences, unstable relationships, and a shifting sense of self. People with BPD often experience emotions more intensely than others and may struggle with emotional regulation. With proper treatment, many people with BPD learn to manage their symptoms effectively."}),"bdd"===t&&(0,r.jsx)("p",{children:"Body Dysmorphic Disorder (BDD) involves excessive concern about perceived flaws in appearance that others may not notice. These concerns can cause significant distress and interfere with daily life. BDD is treatable, and cognitive behavioral therapy has been shown to be very effective for many people."}),"ocd"===t&&(0,r.jsx)("p",{children:"Obsessive-Compulsive Disorder (OCD) involves unwanted, intrusive thoughts (obsessions) and repetitive behaviors or mental acts (compulsions) performed to reduce anxiety. OCD can be distressing and time-consuming, but it's highly treatable with the right approach, including cognitive behavioral therapy and medication when appropriate."}),"social-anxiety"===t&&(0,r.jsx)("p",{children:"Social Anxiety Disorder involves intense fear of social situations where you might be judged, embarrassed, or humiliated. This can lead to avoidance of social activities and significant distress. Social anxiety is treatable, and many people find relief through therapy, particularly cognitive behavioral therapy."}),"postnatal-depression"===t&&(0,r.jsx)("p",{children:"Post-natal depression is a serious mental health condition that can affect new parents, typically within the first year after childbirth. Symptoms can include persistent low mood, loss of interest in activities, changes in sleep and appetite, and difficulty bonding with your baby. This condition is treatable, and early intervention can significantly improve outcomes."})]}),(0,r.jsxs)("div",{className:"bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg p-4",children:[(0,r.jsxs)("h5",{className:"font-medium text-gray-900 dark:text-white mb-3",children:["adhd"===t&&"ADHD-Specific Resources","an