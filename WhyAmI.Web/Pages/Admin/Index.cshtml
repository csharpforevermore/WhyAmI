@page
@{
    Layout = "Shared/_LayoutAdmin";
    ViewData["Title"] = "Admin Home";
}

<div class="text-center">
    <h1 class="display-4">WhyAmI - Admin</h1>
    <p class="lead">Data management and entry portal</p>
    <p>
        <a class="btn btn-primary btn-lg" asp-page="/Admin/Questionnaires/Index">Questionnaires</a>
        <a class="btn btn-primary btn-lg" asp-page="/Admin/Customers/Index">Customers</a>
        <a class="btn btn-primary btn-lg" asp-page="/Admin/Vendors/Index">Vendors</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-outline-danger btn-lg" asp-page="/Logout">Logout</a>
        }
    </p>
</div>
