@page
@model EditModel

@{
    Layout = "Shared/_LayoutAdmin";
    ViewData["Title"] = "Admin - Edit Vendor";
}

<h1>Edit</h1>

<h4>Vendor</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Vendor.Id" />
            <div class="form-group">
                <label asp-for="Vendor.Name" class="control-label"></label>
                <input asp-for="Vendor.Name" class="form-control" />
                <span asp-validation-for="Vendor.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Vendor.Website" class="control-label"></label>
                <input asp-for="Vendor.Website" class="form-control" />
                <span asp-validation-for="Vendor.Website" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Vendor.About" class="control-label"></label>
                <input asp-for="Vendor.About" class="form-control" aria-required="true"/>
                <span asp-validation-for="Vendor.About" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Vendor.ContactDetails" class="control-label"></label>
                <input asp-for="Vendor.ContactDetails" class="form-control" />
                <span asp-validation-for="Vendor.ContactDetails" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
