@page
@model DeleteModel

@{
    Layout = "Shared/_LayoutAdmin";
    ViewData["Title"] = "Admin - Delete Questionnaire";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Questionnaire</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Questionnaire.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Questionnaire.Title)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Questionnaire.ScoreOptions)
        </dt>
        <dd class="col-sm-10">
            @if (Model.Questionnaire.ScoreOptions.Count == 0)
            {
                <span>None</span>
            }
            else
            {
                <ul class="mb-0">
                    @foreach (var option in Model.Questionnaire.ScoreOptions)
                    {
                        <li>@option.Score@(string.IsNullOrWhiteSpace(option.Text) ? "" : $" — {option.Text}")</li>
                    }
                </ul>
            }
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Questionnaire.Questions)
        </dt>
        <dd class="col-sm-10">
            @if (Model.Questionnaire.Questions.Count == 0)
            {
                <span>None</span>
            }
            else
            {
                <ul class="mb-0">
                    @foreach (var question in Model.Questionnaire.Questions)
                    {
                        <li>@question.Text</li>
                    }
                </ul>
            }
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Questionnaire.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
