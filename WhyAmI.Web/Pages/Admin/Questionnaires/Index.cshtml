@page
@model IndexModel

@{
    Layout = "Shared/_LayoutAdmin";
    ViewData["Title"] = "Admin - Create Questionnaire";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Questionnaire[0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Questionnaire[0].Questions)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Questionnaire) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                @item.Questions.Count question@(item.Questions.Count == 1 ? "" : "s")
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
