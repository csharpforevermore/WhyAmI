@page
@model EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Questionnaire</h4>
<hr />
<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Questionnaire.Id" />
            <div class="form-group mb-3">
                <label asp-for="Questionnaire.Title" class="control-label"></label>
                <input asp-for="Questionnaire.Title" class="form-control" />
                <span asp-validation-for="Questionnaire.Title" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Questionnaire.SubTitle" class="control-label"></label>
                <input asp-for="Questionnaire.SubTitle" class="form-control" />
                <span asp-validation-for="Questionnaire.SubTitle" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Questionnaire.Source" class="control-label"></label>
                <input asp-for="Questionnaire.Source" class="form-control" />
                <span asp-validation-for="Questionnaire.Source" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <div class="form-check">
                    <input asp-for="Questionnaire.HasQuestionsWithTrueFalse" class="form-check-input" />
                    <label asp-for="Questionnaire.HasQuestionsWithTrueFalse" class="form-check-label"></label>
                </div>
                <span asp-validation-for="Questionnaire.HasQuestionsWithTrueFalse" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Questionnaire.Description" class="control-label"></label>
                <textarea asp-for="Questionnaire.Description" class="container-fluid"></textarea>
                <span asp-validation-for="Questionnaire.Description" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <div class="form-check">
                    <input asp-for="Questionnaire.IsEnabled" class="form-check-input" />
                    <label asp-for="Questionnaire.IsEnabled" class="form-check-label"></label>
                </div>
                <span asp-validation-for="Questionnaire.IsEnabled" class="text-danger"></span>
            </div>
            <partial name="_ScoreOptionsEditor" model="Model.Questionnaire" />
            <partial name="_QuestionsEditor" model="Model.Questionnaire" />
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
