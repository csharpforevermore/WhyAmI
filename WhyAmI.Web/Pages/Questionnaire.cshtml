@page
@model WhyAmI.Web.Pages.QuestionnaireModel
@{
    ViewData["Title"] = $"Question {Model.StepNumber}";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <p class="text-muted mb-1">Question @Model.StepNumber of @Model.TotalSteps</p>
        <div class="progress mb-4" role="progressbar" aria-valuenow="@Model.StepNumber" aria-valuemin="1" aria-valuemax="@Model.TotalSteps">
            <div class="progress-bar" style="width: @(Model.StepNumber * 100 / Model.TotalSteps)%"></div>
        </div>

        <h1 class="h3 mb-2">@Model.CurrentQuestion.Text</h1>
        <p class="text-muted">@Model.CurrentQuestion.Hint</p>

        <form method="post">
            <div class="mb-3">
                <label asp-for="Answer" class="form-label visually-hidden">Answer</label>
                <textarea asp-for="Answer" class="form-control" rows="3" autofocus></textarea>
                <span asp-validation-for="Answer" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                @if (Model.CanGoBack)
                {
                    <button type="submit" class="btn btn-outline-secondary" asp-page-handler="Previous" formnovalidate>
                        Previous question
                    </button>
                }
                <button type="submit" class="btn btn-primary" asp-page-handler="Next">
                    @(Model.StepNumber == Model.TotalSteps ? "Finish" : "Next")
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
